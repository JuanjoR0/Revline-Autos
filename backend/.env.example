# ===========================
# Ejemplo de variables de entorno para el backend
# Proyecto: RevLine Autos (Django + DRF)
# ===========================

# Clave secreta de Django (sustituir por una real en desarrollo/producción)
SECRET_KEY=tu_clave_secreta_aqui

# Modo debug: True para desarrollo local, False en producción
DEBUG=True

# Dominios permitidos (añadir dominio de Render en producción)
ALLOWED_HOSTS=localhost,127.0.0.1,revline-autos.onrender.com

# Base de datos
# Por defecto, SQLite para desarrollo local
# Para producción en Render, usar el formato:
# postgresql://usuario:contraseña@host:5432/nombre_db
DATABASE_URL=sqlite:///db.sqlite3
